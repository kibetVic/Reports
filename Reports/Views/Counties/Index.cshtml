@model IEnumerable<Reports.Models.County>
@inject IHttpContextAccessor HttpContextAccessor

@{
    ViewData["Title"] = "Counties";
    var userRole = HttpContextAccessor.HttpContext?.Session.GetString("UserRole");
}

<style>
    .table td,
    .table th {
        padding: 4px 8px !important;
        font-size: 12px;
        line-height: 1.2;
    }

    .table tbody tr {
        height: auto !important;
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="fw-bold text-primary mb-0">@ViewData["Title"]</h1>

    @if (userRole == "Admin")
    {
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Create New County
        </a>
    }
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle mb-0">
        <thead class="table-primary">
            <tr>
                <th>@Html.DisplayNameFor(model => model.CountyCode)</th>
                <th>@Html.DisplayNameFor(model => model.Name)</th>

                @if (userRole == "Admin")
                {
                    <th class="text-center">Actions</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.CountyCode)</td>
                    <td>@Html.DisplayFor(modelItem => item.Name)</td>
                    <td class="text-center">
                        @if (userRole == "Admin")
                        {
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning me-1">
                                <i class="bi bi-pencil-square"></i> Edit
                            </a>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info me-1">
                                <i class="bi bi-info-circle"></i> Details
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">
                                <i class="bi bi-trash"></i> Delete
                            </a>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">
                                <i class="bi bi-eye"></i> View
                            </a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
