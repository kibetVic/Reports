<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Payment Management System</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <!-- Add in <head> of _Layout.cshtml -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <!-- Google Font: Source Sans Pro -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,400i,700&display=fallback">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="~/AdminLTE/plugins/fontawesome-free/css/all.min.css">
    <!-- Ionicons -->
    <link rel="stylesheet" href="https://code.ionicframework.com/ionicons/2.0.1/css/ionicons.min.css">
    <!-- Tempusdominus Bootstrap 4 -->
    <link rel="stylesheet" href="~/AdminLTE/plugins/tempusdominus-bootstrap-4/css/tempusdominus-bootstrap-4.min.css">
    <!-- iCheck -->
    <link rel="stylesheet" href="~/AdminLTE/plugins/icheck-bootstrap/icheck-bootstrap.min.css">
    <!-- JQVMap -->
    <link rel="stylesheet" href="~/AdminLTE/plugins/jqvmap/jqvmap.min.css">
    <!-- Theme style -->
    <link rel="stylesheet" href="~/AdminLTE/dist/css/adminlte.min.css">
    <!-- overlayScrollbars -->
    <link rel="stylesheet" href="~/AdminLTE/plugins/overlayScrollbars/css/OverlayScrollbars.min.css">
    <!-- Daterange picker -->
    <link rel="stylesheet" href="~/AdminLTE/plugins/daterangepicker/daterangepicker.css">
    <!-- DataTables -->
    <link rel="stylesheet" href="~/AdminLTE/plugins/datatables-bs4/css/dataTables.bootstrap4.min.css">
    <link rel="stylesheet" href="~/AdminLTE/plugins/datatables-responsive/css/responsive.bootstrap4.min.css">
    <link rel="stylesheet" href="~/AdminLTE/plugins/datatables-buttons/css/buttons.bootstrap4.min.css">
    <!-- summernote -->
    <link rel="stylesheet" href="~/AdminLTE/plugins/summernote/summernote-bs4.min.css">
    <style>
        /* Sidebar Base */
        .sidebar {
            background: #fff;
            border-right: 1px solid #e0e0e0;
            min-height: 100vh;
        }

        /* Logo Styling (not affected by hover or collapse) */
        .logo-img {
            display: block;
            margin: 0 auto;
            width: 170px;
            height: 100px;
            object-fit: cover;
            transition: transform 0.2s ease-in-out;
        }

        /* Nav Links */
        .nav-link {
            color: #333;
            padding: 0.75rem 1rem;
            border-radius: 0.5rem;
            font-weight: 500;
            transition: all 0.2s ease-in-out;
        }

            .nav-link i {
                color: #007bff;
                font-size: 1.1rem;
                width: 25px;
                text-align: center;
            }

            .nav-link:hover {
                background-color: #007bff;
                color: #fff !important;
                transform: translateX(3px);
            }

                .nav-link:hover i {
                    color: #fff;
                }

            /* Active State */
            .nav-link.active {
                background-color: #0d6efd;
                color: #fff !important;
            }

        /* Sub-links */
        .sub-link {
            font-size: 0.95rem;
            color: #555;
            border-left: 3px solid transparent;
        }

            .sub-link:hover {
                background-color: #007bff;
                color: #007bff;
                border-left: 3px solid #007bff;
            }

        /* Dropdown arrow rotation */
        .rotate-icon {
            transition: transform 0.3s ease;
        }

        [aria-expanded="true"] .rotate-icon {
            transform: rotate(180deg);
        }

    </style>
</head>
<body class="hold-transition sidebar-mini layout-fixed">
    <div class="wrapper">
        <nav class="main-header navbar navbar-expand navbar-white navbar-light">
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link" data-widget="pushmenu" href="#" role="button"><i class="fas fa-bars"></i></a>
                </li>
            </ul>

            @inject IHttpContextAccessor HttpContextAccessor
            <ul class="navbar-nav ms-auto align-items-center">
                @{
                    var userName = HttpContextAccessor.HttpContext?.Session.GetString("UserName");
                    var userRole = HttpContextAccessor.HttpContext?.Session.GetString("UserRole");
                    // Get role as integer for easier comparison
                    var userRoleInt = 0;
                    if (!string.IsNullOrEmpty(userRole))
                    {
                        Enum.TryParse(userRole, out Reports.Models.UserRole roleEnum);
                        userRoleInt = (int)roleEnum;
                    }
                }

                @if (!string.IsNullOrEmpty(userName))
                {
                    <li class="nav-item me-3 d-flex align-items-center text-white">
                        <i class="fas fa-user-circle me-1"></i>
                        <span>@userName</span>
                        <small class="text-muted ms-2">(@userRole)</small>
                    </li>

                    <li class="nav-item">
                        <form asp-controller="UserAccounts" asp-action="Logout" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-danger btn-sm">
                                <i class="fas fa-sign-out-alt me-1"></i> Logout
                            </button>
                        </form>
                    </li>
                }
            </ul>
        </nav>
        <aside class="main-sidebar sidebar-light-primary elevation-4">
            <div class="sidebar py-3">

                <!-- ✅ Logo (kept outside <ul> so it doesn’t move) -->
                <div class="container-fluid text-center py-3 border-bottom">
                    <img src="~/images/amtech_logo.png" alt="Amtech" class="logo-img rounded-circle">
                </div>

                <nav class="mt-3">
                    <ul class="nav flex-column" id="sidebarMenu">
                        @if (userRoleInt == 2)
                        {
                            <!-- Dashboard - Accessible to ALL logged-in users -->
                            <li class="nav-item">
                                <a class="nav-link d-flex align-items-center" asp-controller="Dashboard" asp-action="Index">
                                    <i class="fas fa-home me-3"></i>
                                    <span>Dashboard</span>
                                </a>
                            </li>

                            <!-- Certificate - Accessible to ALL logged-in users -->
                            <li class="nav-item">
                                <a class="nav-link d-flex align-items-center" asp-controller="Certificates" asp-action="Index">
                                    <i class="fas fa-certificate me-3"></i>
                                    <span>Certificate</span>
                                </a>
                            </li>
                        }                      

                        <!-- ADMIN ONLY SECTIONS (Role = 1) -->
                        @if (userRoleInt == 1)
                        {
                            <!-- Voucher -->
                            <li class="nav-item">
                                <a class="nav-link d-flex align-items-center" asp-controller="PaymentVouchers" asp-action="Index">
                                    <i class="fas fa-file-invoice-dollar me-3"></i>
                                    <span>Voucher</span>
                                </a>
                            </li>

                            <!-- Summary -->
                            <li class="nav-item">
                                <a class="nav-link d-flex align-items-center" asp-controller="Summaries" asp-action="Index">
                                    <i class="fas fa-chart-bar me-3"></i>
                                    <span>Summary</span>
                                </a>
                            </li>

                            <!-- Reports -->
                            <li class="nav-item">
                                <a class="nav-link d-flex align-items-center" asp-controller="PaymentVouchers" asp-action="Reports">
                                    <i class="fas fa-file-alt me-3"></i>
                                    <span>Reports</span>
                                </a>
                            </li>

                            <!-- Invoice -->
                            <li class="nav-item">
                                <a class="nav-link d-flex align-items-center" asp-controller="Invoices" asp-action="Index">
                                    <i class="fas fa-file-invoice me-3"></i>
                                    <span>Invoice</span>
                                </a>
                            </li>

                            <!-- Quotations -->
                            <li class="nav-item">
                                <a class="nav-link d-flex align-items-center" asp-controller="Quotation" asp-action="Index">
                                    <i class="fas fa-quote-right me-3"></i>
                                    <span>Quotations</span>
                                </a>
                            </li>

                            <!-- Receipts -->
                            <li class="nav-item">
                                <a class="nav-link d-flex align-items-center" asp-controller="Receipts" asp-action="Index">
                                    <i class="fas fa-receipt me-3"></i>
                                    <span>Receipt</span>
                                </a>
                            </li>

                            <!-- Files -->
                            <li class="nav-item">
                                <a class="nav-link d-flex align-items-center" asp-controller="UploadedFiles" asp-action="Index">
                                    <i class="fas fa-file-upload me-3"></i>
                                    <span>Files</span>
                                </a>
                            </li>

                            <!-- Certificate - Accessible to ALL logged-in users -->
                            <li class="nav-item">
                                <a class="nav-link d-flex align-items-center" asp-controller="Certificates" asp-action="Index">
                                    <i class="fas fa-certificate me-3"></i>
                                    <span>Certificate</span>
                                </a>
                            </li>


                            <!-- Setup Dropdown (Admin only) -->
                            <li class="nav-item">
                                <a class="nav-link d-flex align-items-center justify-content-between"
                                   data-bs-toggle="collapse"
                                   href="#setupMenu"
                                   role="button"
                                   aria-expanded="false"
                                   aria-controls="setupMenu">
                                    <span><i class="fas fa-cogs me-3"></i> Setups</span>
                                    <i class="fas fa-angle-down rotate-icon"></i>
                                </a>

                                <div class="collapse" id="setupMenu" data-bs-parent="#sidebarMenu">
                                    <ul class="nav flex-column ms-4 mt-2">
                                        <li class="nav-item">
                                            <a class="nav-link sub-link d-flex align-items-center" asp-controller="Counties" asp-action="Index">
                                                <i class="fas fa-map-marker-alt me-3"></i> County
                                            </a>
                                        </li>
                                        <li class="nav-item">
                                            <a class="nav-link sub-link d-flex align-items-center" asp-controller="UserAccounts" asp-action="Index">
                                                <i class="fas fa-user-cog me-3"></i> Accounts
                                            </a>
                                        </li>
                                    </ul>
                                </div>
                            </li>
                        }

                        <!-- TRAINER ONLY gets Dashboard and Certificate (already shown above) -->
                        <!-- No additional items needed for Trainer as they only see Dashboard and Certificate -->
                        <!-- Note: For other roles (User=0, Accountant=3), you can add specific sections here if needed -->
                        @if (userRoleInt == 3) // Accountant
                        {
                            <!-- Add Accountant-specific sections here if needed -->
                            <!-- For now, Accountant only sees Dashboard and Certificate -->
                        }

                        @if (userRoleInt == 0) // User
                        {
                            <!-- Add User-specific sections here if needed -->
                            <!-- For now, User only sees Dashboard and Certificate -->
                        }
                        
                    </ul>
                </nav>
            </div>
        </aside>
        <div class="content-wrapper">
            <section class="content">
                <div class="container-fluid">
                    @RenderBody()
                    @if (TempData["ToastMessage"] != null)
                    {
                        <div class="alert alert-@((TempData["ToastType"] as string) ?? "info") alert-dismissible fade show mt-3" role="alert">
                            @TempData["ToastMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }
                </div>
            </section>
        </div>
    </div>
    <footer class="main-footer text-center">
        <strong style="font-size:12px">Copyright &copy; @DateTime.Now.Year <a href="https://amtechafrica.com/">Powered By AmTech Technologies Ltd</a>.</strong>
        All rights reserved.
    </footer>
    <aside class="control-sidebar control-sidebar-dark">
    </aside>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/AdminLTE/plugins/jquery/jquery.min.js"></script>
    <script src="~/AdminLTE/plugins/jquery-ui/jquery-ui.min.js"></script>
    <script>$.widget.bridge('uibutton', $.ui.button)</script>
    <script src="~/AdminLTE/plugins/bootstrap/js/bootstrap.bundle.min.js"></script>
    <!-- Sparkline -->
    <script src="~/AdminLTE/plugins/sparklines/sparkline.js"></script>
    <!-- JQVMap -->
    <script src="~/AdminLTE/plugins/jqvmap/jquery.vmap.min.js"></script>
    <script src="~/AdminLTE/plugins/jqvmap/maps/jquery.vmap.usa.js"></script>
    <!-- jQuery Knob Chart -->
    <script src="~/AdminLTE/plugins/jquery-knob/jquery.knob.min.js"></script>
    <!-- daterangepicker -->
    <script src="~/AdminLTE/plugins/moment/moment.min.js"></script>
    <script src="~/AdminLTE/plugins/daterangepicker/daterangepicker.js"></script>
    <!-- Tempusdominus Bootstrap 4 -->
    <script src="~/AdminLTE/plugins/tempusdominus-bootstrap-4/js/tempusdominus-bootstrap-4.min.js"></script>
    <!-- Summernote -->
    <script src="~/AdminLTE/plugins/summernote/summernote-bs4.min.js"></script>
    <!-- overlayScrollbars -->
    <script src="~/AdminLTE/plugins/overlayScrollbars/js/jquery.overlayScrollbars.min.js"></script>
    <!-- AdminLTE App -->
    <script src="~/AdminLTE/dist/js/adminlte.js"></script>

    <!-- DataTables  & Plugins -->
    <script src="~/AdminLTE/plugins/datatables/jquery.dataTables.min.js"></script>
    <script src="~/AdminLTE/plugins/datatables-bs4/js/dataTables.bootstrap4.min.js"></script>
    <script src="~/AdminLTE/plugins/datatables-responsive/js/dataTables.responsive.min.js"></script>
    <script src="~/AdminLTE/plugins/datatables-responsive/js/responsive.bootstrap4.min.js"></script>
    <script src="~/AdminLTE/plugins/datatables-buttons/js/dataTables.buttons.min.js"></script>
    <script src="~/AdminLTE/plugins/datatables-buttons/js/buttons.bootstrap4.min.js"></script>
    <script src="~/AdminLTE/plugins/jszip/jszip.min.js"></script>
    <script src="~/AdminLTE/plugins/pdfmake/pdfmake.min.js"></script>
    <script src="~/AdminLTE/plugins/pdfmake/vfs_fonts.js"></script>
    <script src="~/AdminLTE/plugins/datatables-buttons/js/buttons.html5.min.js"></script>
    <script src="~/AdminLTE/plugins/datatables-buttons/js/buttons.print.min.js"></script>
    <script src="~/AdminLTE/plugins/datatables-buttons/js/buttons.colVis.min.js"></script>

    <!-- Charts (shared across dashboards) -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Global defaults
        Chart.defaults.animation = false;
        Chart.defaults.responsive = true;
        Chart.defaults.maintainAspectRatio = false;
        Chart.defaults.plugins.legend.position = 'bottom';
        Chart.defaults.font.size = 12;

        function renderCharts(model) {
            if (!model) return;

            // PIE (classic)
            new Chart(document.getElementById('pieChart'), {
                type: 'pie',
                data: {
                    labels: model.PaymentStatusLabels,
                    datasets: [{
                        data: model.PaymentStatusValues,
                        backgroundColor: ['#4CAF50', '#F44336', '#FFC107', '#2196F3']
                    }]
                }
            });

            // BAR
            new Chart(document.getElementById('barChart'), {
                type: 'bar',
                data: {
                    labels: model.SummaryLabels,
                    datasets: [{
                        label: 'Total per County',
                        data: model.SummaryValues,
                        backgroundColor: '#2196F3'
                    }]
                }
            });

            // LINE
            new Chart(document.getElementById('lineChart'), {
                type: 'line',
                data: {
                    labels: model.VoucherDates,
                    datasets: [{
                        label: 'Voucher Totals',
                        data: model.VoucherTotals,
                        borderColor: '#4CAF50',
                        fill: false,
                        tension: 0
                    }]
                }
            });

            // SCATTER
            new Chart(document.getElementById('scatterChart'), {
                type: 'scatter',
                data: {
                    datasets: [{
                        label: 'Voucher Total vs Summary Count',
                        data: model.ScatterPoints,
                        backgroundColor: '#F44336'
                    }]
                }
            });

            // MODERN DOUGHNUT
            new Chart(document.getElementById('doughnutChart'), {
                type: 'doughnut',
                data: {
                    labels: model.PaymentStatusLabels,
                    datasets: [{
                        data: model.PaymentStatusValues,
                        backgroundColor: ['#36A2EB', '#FF6384', '#FFCE56', '#4BC0C0'],
                        borderWidth: 2,
                        borderColor: '#fff'
                    }]
                },
                options: {
                    cutout: '60%',
                    plugins: {
                        legend: { position: 'right' },
                        tooltip: {
                            backgroundColor: '#333',
                            titleColor: '#fff',
                            bodyColor: '#eee'
                        }
                    }
                }
            });

            // MODERN RING
            new Chart(document.getElementById('ringChart'), {
                type: 'doughnut',
                data: {
                    labels: model.SummaryLabels,
                    datasets: [{
                        data: model.SummaryValues,
                        backgroundColor: [
                            'rgba(75, 192, 192, 0.7)',
                            'rgba(255, 99, 132, 0.7)',
                            'rgba(255, 206, 86, 0.7)',
                            'rgba(54, 162, 235, 0.7)'
                        ],
                        hoverOffset: 10
                    }]
                },
                options: {
                    cutout: '70%',
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: {
                                padding: 20,
                                usePointStyle: true
                            }
                        }
                    }
                }
            });
        }
    </script>

    <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>