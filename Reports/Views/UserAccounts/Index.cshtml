@model IEnumerable<Reports.Models.UserAccount>
@inject IHttpContextAccessor HttpContextAccessor

@{
    ViewData["Title"] = "User Accounts";
    var userRole = HttpContextAccessor.HttpContext?.Session.GetString("UserRole");
}

<style>
    .table td,
    .table th {
        padding: 4px 8px !important;
        font-size: 12px;
        line-height: 1.2;
    }

    .table tbody tr {
        height: auto !important;
    }
</style>

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="fw-bold text-primary">@ViewData["Title"]</h1>

        @if (userRole == "Admin")
        {
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-person-plus"></i> Add New User
            </a>
        }
    </div>

    <div class="row mb-3">
        <div class="col-md-4">
            <input type="text" id="searchBox" class="form-control"
                   placeholder="Search by username, email or name..." />
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-bordered align-middle">
            <thead class="table-light">
                <tr>
                    <th>No.</th>
                    <th>@Html.DisplayNameFor(model => model.Username)</th>
                    <th>@Html.DisplayNameFor(model => model.Email)</th>
                    <th>Full Name</th>
                    <th>Phone Number</th>
                    <th>@Html.DisplayNameFor(model => model.Role)</th>
                    <th>@Html.DisplayNameFor(model => model.CreatedAt)</th>
                    <th>@Html.DisplayNameFor(model => model.LastLoginAt)</th>

                    @if (userRole == "Admin")
                    {
                        <th class="text-center">Actions</th>
                    }
                    else
                    {
                        <th class="text-center">View</th>
                    }
                </tr>
            </thead>
            <tbody id="userTable">
                @{
                    var counter = 1;
                }
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@counter</td>
                        <td>@item.Username</td>
                        <td>@item.Email</td>
                        <td>@item.FullName</td>
                        <td>@item.PhoneNumber</td>
                        <td>@item.Role</td>
                        <td>@item.CreatedAt.ToString("yyyy-MM-dd")</td>
                        <td>@item.LastLoginAt?.ToString("yyyy-MM-dd HH:mm")</td>
                        <td class="text-center">
                            @if (userRole == "Admin")
                            {
                                <div class="btn-group btn-group-sm" role="group">
                                    <a asp-action="Edit" asp-route-id="@item.Id"
                                       class="btn btn-sm btn-outline-warning">
                                        <i class="bi bi-pencil-square"></i> Edit
                                    </a>
                                    <a asp-action="Details" asp-route-id="@item.Id"
                                       class="btn btn-sm btn-outline-info">
                                        <i class="bi bi-eye"></i> Details
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id"
                                       class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash"></i> Delete
                                    </a>
                                    <a asp-action="Details" asp-route-id="@item.Id"
                                       class="btn btn-sm btn-outline-info">
                                        <i class="bi bi-eye"></i> View
                                    </a>
                                </div>
                            }
                        </td>
                    </tr>
                    counter++;
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        // 🔍 Client-side search
        const searchBox = document.getElementById("searchBox");
        const tableRows = document.querySelectorAll("#userTable tr");

        searchBox.addEventListener("keyup", function () {
            const query = this.value.toLowerCase();
            tableRows.forEach(row => {
                const rowText = Array.from(row.cells).slice(1, -1)
                    .map(cell => cell.textContent.toLowerCase())
                    .join(" ");
                row.style.display = rowText.includes(query) ? "" : "none";
            });
        });
    </script>
}
