@model Reports.Models.Quotation
@{
    ViewData["Title"] = "Edit Quotation";
}

<div class="container mt-5">
    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-header bg-primary text-white rounded-top-4">
            <h3 class="mb-0"><i class="bi bi-receipt-cutoff me-2"></i>Quotation Form</h3>
        </div>

        <div class="card-body p-4">

            @if (ViewBag.ErrorMessage != null)
            {
                <div class="alert alert-danger">
                    <strong>Error:</strong> @ViewBag.ErrorMessage
                </div>
            }

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success">
                    <strong>Success:</strong> @TempData["SuccessMessage"]
                </div>
            }

            @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="Id" />

                <div class="row mb-4">
                    <div class="col-md-4">
                        <label asp-for="QuotationNumber" class="form-label fw-bold"></label>
                        <input asp-for="QuotationNumber" class="form-control shadow-sm" readonly />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="ClientName" class="form-label fw-bold"></label>
                        <input asp-for="ClientName" class="form-control shadow-sm" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="PhoneNomber" class="form-label fw-bold"></label>
                        <input asp-for="PhoneNomber" class="form-control shadow-sm" />
                    </div>
                </div>

                <h5 class="mt-4 text-primary fw-semibold">Quotation Items</h5>
                <div class="table-responsive">
                    <table class="table table-bordered table-hover mt-2" id="itemsTable">
                        <thead class="table-light text-center align-middle">
                            <tr>
                                <th>Description</th>
                                <th>Qty</th>
                                <th>Price per Qty</th>
                                <th>Amount (Ksh)</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.Items.Count; i++)
                            {
                                <tr>
                                    <td style="width: 40%;">
                                        <textarea name="Items[0].Description" class="form-control" required
                                              style="width:100%; min-width:400px; height:50px;"></textarea>
                                    </td>
                                    <td><input name="Items[@i].Qty" value="@Model.Items[i].Qty" type="number" class="form-control qty" /></td>
                                    <td><input name="Items[@i].PricePerQty" value="@Model.Items[i].PricePerQty" type="number" class="form-control price" /></td>
                                    <td><input name="Items[@i].Amount" value="@Model.Items[i].Amount" type="number" class="form-control amount" readonly /></td>
                                    <td class="text-center">
                                        <button type="button" class="btn btn-sm btn-outline-danger removeRow">
                                            <i class="bi bi-x-circle">Remove</i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="row mb-4">
                    <div class="col-md-4">
                        <button type="button" id="addRow" class="btn btn-outline-primary mt-2 shadow-sm">
                            <i class="bi bi-plus-circle"></i> Add Item
                        </button>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center mt-4">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="AddVAT" name="AddVAT" value="true" />
                        <label class="form-check-label fw-semibold" for="AddVAT">Add 16% VAT</label>
                    </div>
                    <div>
                        <button type="submit" class="btn btn-success px-4 shadow-sm">
                            <i class="bi bi-check2-circle"></i> Update
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary px-4 ms-2 shadow-sm">
                            <i class="bi bi-arrow-left-circle"></i> Cancel
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let rowIndex = @Model.Items.Count;

        document.getElementById("addRow").addEventListener("click", () => {
            const table = document.querySelector("#itemsTable tbody");
            const newRow = document.createElement("tr");
            newRow.innerHTML = `
                <td><textarea name="Items[${rowIndex}].Description" class="form-control" rows="2" required></textarea></td>
                <td><input name="Items[${rowIndex}].Qty" type="number" class="form-control qty" required /></td>
                <td><input name="Items[${rowIndex}].PricePerQty" type="number" class="form-control price" required /></td>
                <td><input name="Items[${rowIndex}].Amount" type="number" class="form-control amount" readonly /></td>
                <td class="text-center"><button type="button" class="btn btn-sm btn-outline-danger removeRow"><i class="bi bi-x-circle">Remove</i></button></td>
            `;
            table.appendChild(newRow);
            rowIndex++;
        });

        document.addEventListener("click", (e) => {
            if (e.target.classList.contains("removeRow") || e.target.closest(".removeRow")) {
                e.target.closest("tr").remove();
            }
        });

        document.addEventListener("input", (e) => {
            if (e.target.classList.contains("qty") || e.target.classList.contains("price")) {
                const row = e.target.closest("tr");
                const qty = parseFloat(row.querySelector(".qty").value) || 0;
                const price = parseFloat(row.querySelector(".price").value) || 0;
                row.querySelector(".amount").value = (qty * price).toFixed(2);
            }
        });
    </script>
}
